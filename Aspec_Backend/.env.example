APP_NAME=ASPEC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost,127.0.0.1:5173,127.0.0.1

SESSION_DRIVER=database
SESSION_DOMAIN=localhost
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Envio real pelo Gmail do projeto (demonstração; ver README, secção "Email"):
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=geral.teste.aspec@gmail.com
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=geral.teste.aspec@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Faturação: "log" (sem serviço externo), "demo" (PDF sem validade fiscal em storage/app/private/invoices,
# enviado por email) ou "invoiceexpress". A chave real só no .env local.
INVOICING_DRIVER=log
# IVA das faturas, comum a todos os drivers. A quota é isenta (taxa 0). O código do motivo de isenção
# (tabela da AT) é decidido pelo contabilista da ASPEC; candidatos: M07 (art. 9.º do CIVA), M10 (art. 53.º)
# ou M99 (não sujeito). Vazio por omissão: o driver invoiceexpress recusa emitir faturas isentas sem código.
# O motivo em texto aparece no PDF demo e no log. Com IVA: INVOICE_VAT_RATE=23 e código vazio.
INVOICE_VAT_RATE=0
INVOICE_VAT_EXEMPTION_CODE=
INVOICE_VAT_EXEMPTION_REASON="Isento de IVA: motivo legal a definir (texto provisório)"
INVOICEEXPRESS_ACCOUNT_NAME=
INVOICEEXPRESS_API_KEY=
INVOICEEXPRESS_DOCUMENT_TYPE=invoice_receipts
INVOICEEXPRESS_SEQUENCE_ID=
INVOICEEXPRESS_ITEM_NAME="Quota Anual ASPEC"
# Nome da taxa de IVA na conta InvoiceExpress (tem de existir lá; confirmar com GET /taxes.json).
INVOICEEXPRESS_TAX_NAME=IVA0
INVOICEEXPRESS_TIMEOUT=10
INVOICEEXPRESS_RETRY_TIMES=3
INVOICEEXPRESS_RETRY_SLEEP_MS=500

# Chaves do modo de teste do Stripe: só no .env local (nunca chaves live, nunca commitar).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Obrigatório fora de local/testing: id da configuração do Billing Portal (bpc_...), ver README.
STRIPE_BILLING_PORTAL_CONFIGURATION=
CASHIER_CURRENCY=eur
# Quota definida pelo cliente (30/10/2026): 30 € por ano. A periodicidade (month ou year) tem de ser igual
# ao intervalo do Price do Stripe (STRIPE_PRICE_ID).
# Depois de mudar o Price ou estes valores: php artisan subscriptions:check-price
SUBSCRIPTION_INTERVAL=year
SUBSCRIPTION_PRICE_AMOUNT=30.00
SUBSCRIPTION_TRIAL_DAYS=30
SUBSCRIPTION_GRACE_DAYS=7
ACTIVATION_LINK_DAYS=7
REACTIVATION_LINK_DAYS=7
SUBSCRIPTION_INVOICE_DESCRIPTION="Quota Anual ASPEC"

# Primeiro administrador (php artisan aspec:create-admin)
ASPEC_ADMIN_EMAIL=
ASPEC_ADMIN_PASSWORD=

# Fuso horário dos eventos
EVENT_TIMEZONE=Europe/Lisbon

# Geocodificação de moradas (Nominatim / OpenStreetMap). Política do servidor público: máx. 1 pedido/s,
# User-Agent identificável, cache. O email de contacto vai no User-Agent e no parâmetro email do Nominatim.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT_EMAIL=
NOMINATIM_COUNTRY_CODES=pt
NOMINATIM_TIMEOUT=5
NOMINATIM_CACHE_DAYS=30

# Fornecedor da geocodificação: nominatim (por omissão, sem chave) ou google.
# Só mudar para "google" depois das ASPEC-414 e 415 estarem em dev.
GEOCODING_DRIVER=nominatim

# Google Maps Platform (Geocoding API). Chave restrita só à Geocoding API; pedir ao Mário.
# Pelos termos do Google só se guarda o place_id (latitude/longitude no máximo 30 dias).
GOOGLE_MAPS_GEOCODING_KEY=
GOOGLE_MAPS_TIMEOUT=5
# Dias da cache dos resultados do Google: máximo 30 (valores maiores contam como 30).
GOOGLE_MAPS_CACHE_DAYS=30
